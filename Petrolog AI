      geo.ore.slice(0,6).forEach(o=>{h+='<div class="kv"><span>'+o.el+'</span><b>'+o.val.toFixed(1)+' ppm &nbsp;<span style="color:#00c48c">×'+o.k.toFixed(1)+'</span></b></div>';});
    } else h+='<div style="color:#8b98a9;font-size:13px">Klarkdan sezilarli ortiq element aniqlanmadi.</div>';
    h+='</div></div>';
    geo.flags.forEach(f=>{h+='<div class="tag" style="display:block;margin-top:8px">'+f+'</div>';});
    h+='</div>';
  }

  // matnli petrografik tavsif
