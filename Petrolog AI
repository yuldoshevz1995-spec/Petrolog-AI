<script>
/* =========================================================
   Petrolog AI — demo tahlil yadrosi (v0.1)
   Segmentatsiya: k-means (RGB + HSV + lokal tekstura)
   Mineral moslashtirish: optik xossalar bo'yicha reference jadval
   ESLATMA: bu bosqichda CNN o'qitilmagan. Bu — tayyor MVP karkasi.
   ========================================================= */

const REF = {
  thin: [ // shlif — o'tgan nurda
    {n:'Kvars',            h:[0,360], s:[0,.14], v:[.55,1],   tex:[0,.35], note:'rangsiz, relyef past, to\'lqinsimon so\'nish'},
