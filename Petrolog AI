const PALETTE = ['#4a9eff','#00c48c','#f2b544','#ff6b6b','#a78bfa','#22d3ee','#f472b6','#94a3b8','#84cc16'];

let IMG1=null, IMG2=null, LAST=null;

/* ---------- fayl yuklash ---------- */
function bind(dropId, inpId, cb){
  const d=document.getElementById(dropId), i=document.getElementById(inpId);
  d.onclick=()=>i.click();
  d.ondragover=e=>{e.preventDefault();d.classList.add('has')};
  d.ondragleave=()=>d.classList.remove('has');
  d.ondrop=e=>{e.preventDefault();if(e.dataTransfer.files[0])load(e.dataTransfer.files[0])};
  i.onchange=e=>{if(e.target.files[0])load(e.target.files[0])};
  function load(file){
    const r=new FileReader();
    r.onload=ev=>{const im=new Image();im.onload=()=>{d.classList.add('has');d.innerHTML=file.name+'<br><small>'+im.width+'×'+im.height+' px</small>';cb(im);check()};im.src=ev.target.result};
    r.readAsDataURL(file);
  }
}
bind('d1','f1',im=>IMG1=im);
bind('d2','f2',im=>IMG2=im);

document.getElementById('icp').oninput=e=>{
  const n=parseICP(e.target.value).length;
  document.getElementById('tagIcp').textContent=n+' ta element';
  check();
};
function check(){
  const m=document.getElementById('mode').value;
  const ok = m==='geo' ? parseICP(document.getElementById('icp').value).length>0 : !!(IMG1||IMG2);
  document.getElementById('run').disabled=!ok;
}
document.getElementById('mode').onchange=check;

/* ---------- ICP parser ---------- */
function parseICP(txt){
  const out=[];
  txt.split(/\n/).forEach(l=>{
    const p=l.split(/[,;\t]/).map(s=>s.trim());
    if(p.length<2) return;
    const v=parseFloat(p[1].replace(',','.'));
    if(!p[0]||isNaN(v)) return;
    if(/element|oksid/i.test(p[0])) return;
    out.push({el:p[0], val:v, unit:p[2]||(v>100?'ppm':'%')});
  });
  return out;
}

/* ---------- rang konvertatsiya ---------- */
function rgb2hsv(r,g,b){
  r/=255;g/=255;b/=255;
  const mx=Math.max(r,g,b), mn=Math.min(r,g,b), d=mx-mn;
  let h=0;
  if(d){ if(mx===r) h=60*(((g-b)/d)%6); else if(mx===g) h=60*((b-r)/d+2); else h=60*((r-g)/d+4); }
  if(h<0)h+=360;
  return [h, mx?d/mx:0, mx];
}

/* ---------- k-means segmentatsiya ---------- */
function segment(img, K){
  const W=Math.min(img.width,520), H=Math.round(img.height*W/img.width);
  const c=document.createElement('canvas'); c.width=W;c.height=H;
  const g=c.getContext('2d',{willReadFrequently:true}); g.drawImage(img,0,0,W,H);
  const px=g.getImageData(0,0,W,H), D=px.data;
  const N=W*H;

  // lokal tekstura: 3x3 gradient magnitudasi (normallashtirilgan)
  const gray=new Float32Array(N), tex=new Float32Array(N);
  for(let i=0;i<N;i++) gray[i]=(D[i*4]*.299+D[i*4+1]*.587+D[i*4+2]*.114)/255;
  let tmax=1e-6;
  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
    const i=y*W+x;
    const gx=gray[i-1]-gray[i+1], gy=gray[i-W]-gray[i+W];
    const m=Math.sqrt(gx*gx+gy*gy); tex[i]=m; if(m>tmax)tmax=m;
  }
  for(let i=0;i<N;i++) tex[i]/=tmax;

  // xususiyat vektori: [r,g,b,tex*w]
  const F=new Float32Array(N*4);
  for(let i=0;i<N;i++){F[i*4]=D[i*4]/255;F[i*4+1]=D[i*4+1]/255;F[i*4+2]=D[i*4+2]/255;F[i*4+3]=tex[i]*0.8;}

  // k-means++ boshlang'ich markazlar
  const C=new Float32Array(K*4);
  let seed=42; const rnd=()=>{seed=(seed*1103515245+12345)&0x7fffffff;return seed/0x7fffffff;};
  let idx=Math.floor(rnd()*N);
  for(let d=0;d<4;d++) C[d]=F[idx*4+d];
  const dist=new Float32Array(N).fill(1e9);
  for(let k=1;k<K;k++){
    let sum=0;
    for(let i=0;i<N;i++){
      let d2=0; for(let d=0;d<4;d++){const t=F[i*4+d]-C[(k-1)*4+d]; d2+=t*t;}
      if(d2<dist[i]) dist[i]=d2; sum+=dist[i];
    }
    let t=rnd()*sum, acc=0, pick=0;
    for(let i=0;i<N;i++){acc+=dist[i]; if(acc>=t){pick=i;break;}}
    for(let d=0;d<4;d++) C[k*4+d]=F[pick*4+d];
  }

  // iteratsiyalar
  const lab=new Uint8Array(N);
  for(let it=0;it<14;it++){
    const S=new Float64Array(K*4), cnt=new Float64Array(K);
    for(let i=0;i<N;i++){
      let best=0,bd=1e9;
      for(let k=0;k<K;k++){
        let d2=0; for(let d=0;d<4;d++){const t=F[i*4+d]-C[k*4+d]; d2+=t*t;}
        if(d2<bd){bd=d2;best=k;}
      }
      lab[i]=best; cnt[best]++;
      for(let d=0;d<4;d++) S[best*4+d]+=F[i*4+d];
    }
    for(let k=0;k<K;k++) if(cnt[k]) for(let d=0;d<4;d++) C[k*4+d]=S[k*4+d]/cnt[k];
  }

  // klaster statistikasi
  const stats=[];
  for(let k=0;k<K;k++){
    let n=0,r=0,g2=0,b=0,tx=0;
    for(let i=0;i<N;i++) if(lab[i]===k){n++;r+=D[i*4];g2+=D[i*4+1];b+=D[i*4+2];tx+=tex[i];}
    if(!n) continue;
    const R=r/n,G=g2/n,B=b/n, hsv=rgb2hsv(R,G,B);
    stats.push({k, n, pct:n/N*100, rgb:[R,G,B], h:hsv[0], s:hsv[1], v:hsv[2], tex:tx/n});
  }
  stats.sort((a,b)=>b.pct-a.pct);
  return {W,H,lab,stats,srcCanvas:c};
}

/* ---------- mineralga moslashtirish ---------- */
function matchMineral(st, kind){
  const list=REF[kind]||REF.thin;
  let best=null, bestScore=-1;
  list.forEach(m=>{
    let sc=0;
    // hue (aylanma)
    const hIn = m.h[0]<=m.h[1] ? (st.h>=m.h[0]&&st.h<=m.h[1]) : (st.h>=m.h[0]||st.h<=m.h[1]);
    sc += hIn?1:0;
    sc += (st.s>=m.s[0]&&st.s<=m.s[1])?1.2:Math.max(0,1.2-3*Math.min(Math.abs(st.s-m.s[0]),Math.abs(st.s-m.s[1])));
    sc += (st.v>=m.v[0]&&st.v<=m.v[1])?1.4:Math.max(0,1.4-3*Math.min(Math.abs(st.v-m.v[0]),Math.abs(st.v-m.v[1])));
    sc += (st.tex>=m.tex[0]&&st.tex<=m.tex[1])?0.6:0;
    if(sc>bestScore){bestScore=sc;best=m;}
  });
  const conf=Math.max(.28, Math.min(.94, bestScore/4.2));
  return {name:best.n, note:best.note, conf};
}

/* ---------- geokimyo ---------- */
function geochem(rows){
  const g={}; rows.forEach(r=>g[r.el.toUpperCase().replace(/\s/g,'')]=r);
  const get=k=>g[k]?g[k].val:null;
  const si=get('SIO2'), na=get('NA2O'), k2=get('K2O'), al=get('AL2O3'),
        ca=get('CAO'), mg=get('MGO'), fe=get('FE2O3')||get('FEO');
  const out={rock:null, alk:null, ai:null, ci:null, ore:[], flags:[]};
  if(si!=null){
    const alk=(na||0)+(k2||0);
    out.alk=alk.toFixed(2);
    let name;
    if(si<45) name='ultraasosli (ultramafik)';
    else if(si<52) name = alk>5 ? 'ishqorli bazalt / gabbro' : 'bazalt / gabbro (asosli)';
    else if(si<63) name = alk>7 ? 'trakiandezit / monsonit' : 'andezit / diorit (o\'rtacha)';
    else if(si<69) name = alk>8 ? 'trakit / sienit' : 'dasit / granodiorit';
    else name = alk>9 ? 'ishqorli granit' : 'riolit / granit (nordon)';
    out.rock=name;
    out.flags.push('TAS bo\'yicha dastlabki tasnif: SiO₂ '+si+' %, Na₂O+K₂O '+alk.toFixed(2)+' %');
  }
  if(al!=null&&na!=null&&k2!=null){
    const A=al/101.96, N=na/61.98, K=k2/94.2, C=(ca||0)/56.08;
    const ai=A/(N+K); const acnk=A/(C+N+K);
    out.ai=ai.toFixed(2); out.ci=acnk.toFixed(2);
    if(acnk>1.1) out.flags.push('A/CNK = '+acnk.toFixed(2)+' → peralyuminiy (S-tipdagi granitoidlarga xos)');
    else if(ai<1) out.flags.push('A/NK = '+ai.toFixed(2)+' → peralkalin tendensiya');
    else out.flags.push('A/CNK = '+acnk.toFixed(2)+' → metalyuminiy / I-tip');
  }
  [['CU','Mis',60],['AU','Oltin',0.05],['AG','Kumush',1],['PB','Qo\'rg\'oshin',30],
   ['ZN','Rux',80],['MO','Molibden',3],['W','Volfram',3],['AS','Margimush',10],['SB','Surma',1]]
   .forEach(([sym,nm,clark])=>{
     const r=g[sym]; if(!r) return;
     let v=r.val; if(/%/.test(r.unit)) v*=10000;
     const kk=v/clark;
     if(kk>=3) out.ore.push({el:nm, val:v, k:kk});
   });
  out.ore.sort((a,b)=>b.k-a.k);
  return out;
}

/* ---------- render ---------- */
function overlay(seg, colors){
  const c=document.createElement('canvas'); c.width=seg.W;c.height=seg.H;
  const g=c.getContext('2d'); const im=g.createImageData(seg.W,seg.H);
  const map={}; colors.forEach((hex,i)=>{map[i]=[parseInt(hex.slice(1,3),16),parseInt(hex.slice(3,5),16),parseInt(hex.slice(5,7),16)];});
  for(let i=0;i<seg.W*seg.H;i++){
    const rgb=map[seg.lab[i]]||[80,80,80];
    im.data[i*4]=rgb[0];im.data[i*4+1]=rgb[1];im.data[i*4+2]=rgb[2];im.data[i*4+3]=255;
  }
  g.putImageData(im,0,0);
  return c;
}

function confClass(c){return c>=.7?'c-hi':c>=.5?'c-md':'c-lo';}
function confTxt(c){return c>=.7?'Yuqori':c>=.5?'O\'rta':'Past';}

