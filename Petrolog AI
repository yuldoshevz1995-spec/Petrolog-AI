    {n:'Kaliyli dala shpati',h:[20,60],s:[.05,.3],v:[.5,.95], tex:[.1,.6], note:'sarg\'ish, past relyef, pertit'},
    {n:'Biotit',           h:[15,45], s:[.35,1], v:[.2,.6],   tex:[.2,1],  note:'kuchli pleoxroizm, jigarrang-qora'},
    {n:'Amfibol (rogovaya obmanka)',h:[70,170],s:[.25,1],v:[.15,.6],tex:[.2,1],note:'yashil-jigarrang pleoxroizm'},
    {n:'Piroksen',         h:[40,110],s:[.15,.6],v:[.3,.75],  tex:[.15,.8],note:'yuqori relyef, ikki tomonlama ajralish'},
    {n:'Xlorit / serisit (o\'zgargan)',h:[80,160],s:[.15,.55],v:[.35,.8],tex:[.25,1],note:'ikkilamchi minerallar, alteratsiya'},
    {n:'Karbonat (kalsit)',h:[0,360], s:[0,.2],  v:[.7,1],    tex:[0,.4],  note:'yuqori ikki nurlanish, romb ajralish'},
    {n:'Ruda minerali (o\'tmas)',h:[0,360],s:[0,1],v:[0,.18], tex:[0,1],   note:'o\'tgan nurda qora, anshlifda aniqlanadi'},
  ],
  pol: [ // anshlif — qaytgan nurda
    {n:'Pirit',            h:[40,65], s:[.15,.6],v:[.6,1],    tex:[0,.6],  note:'och sariq, yuqori qaytarish, izotrop'},
    {n:'Xalkopirit',       h:[38,60], s:[.35,1], v:[.5,.95],  tex:[0,.7],  note:'to\'q sariq, zaif anizotrop'},
    {n:'Galenit',          h:[0,360], s:[0,.12], v:[.65,1],   tex:[0,.5],  note:'oq, uchburchak yemirilish chuqurchalari'},
    {n:'Sfalerit',         h:[0,40],  s:[.1,.45],v:[.25,.6],  tex:[.1,.8], note:'kulrang, ichki refleks'},
    {n:'Arsenopirit',      h:[0,360], s:[0,.15], v:[.7,1],    tex:[0,.5],  note:'oq-sariq, kuchli anizotrop'},
    {n:'Magnetit',         h:[0,360], s:[0,.15], v:[.3,.55],  tex:[0,.6],  note:'kulrang-jigarrang, izotrop'},
    {n:'Gematit',          h:[0,25],  s:[.2,.7], v:[.3,.7],   tex:[.1,.8], note:'kulrang, qizil ichki refleks'},
    {n:'Nometall (gangue)',h:[0,360], s:[0,1],  v:[0,.3],     tex:[0,1],   note:'to\'q kulrang massa — silikat asos'},
  ]
